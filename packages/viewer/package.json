{
  "name": "@twin-studio/viewer",
  "version": "0.4.0",
  "packageManager": "pnpm@10.20.0",
  "description": "Portable Vue 3 viewer runtime for Twin Studio .twin.zip projects",
  "type": "module",
  "files": [
    "dist",
    "index.d.ts",
    "README.md"
  ],
  "main": "./dist/twin-viewer.js",
  "module": "./dist/twin-viewer.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./index.d.ts",
      "import": "./dist/twin-viewer.js"
    },
    "./style.css": "./dist/twin-viewer.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "type-check": "vue-tsc --noEmit",
    "build": "pnpm run type-check && vite build",
    "pack:sdk": "pnpm pack"
  },
  "peerDependencies": {
    "three": "0.184.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@twin-studio/core": "workspace:*",
    "@types/node": "24.10.1",
    "@types/three": "0.184.0",
    "@vitejs/plugin-vue": "5.2.4",
    "three": "0.184.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vue": "3.5.25",
    "vue-tsc": "3.1.5"
  },
  "engines": {
    "node": ">=20.16.0"
  }
}
